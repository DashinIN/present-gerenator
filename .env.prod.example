# Public app URL
BASE_URL=https://funbaza.com

# Public storage URL used in presigned links
S3_PUBLIC_ENDPOINT=https://storage.funbaza.com
S3_REGION=us-east-1
S3_BUCKET=funbaza
S3_USE_PATH_STYLE=true

# Secrets
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-long-random-jwt-secret-at-least-32-chars
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-very-strong-minio-password

# App settings
APP_ENV=production
WORKER_COUNT=4
KIE_API_KEY=

# Admin / observability
PGADMIN_DEFAULT_EMAIL=admin@funbaza.com
PGADMIN_DEFAULT_PASSWORD=change-me-strong-pgadmin-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password
PROMETHEUS_RETENTION=30d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://funbaza.com/api/auth/google/callback

# SSL / certbot
LETSENCRYPT_EMAIL=admin@funbaza.com
