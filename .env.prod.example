# Public app URL
BASE_URL=https://api.yourdomain.com

# Public storage URL used in presigned links
S3_PUBLIC_ENDPOINT=https://storage.yourdomain.com
S3_REGION=us-east-1
S3_BUCKET=funbaza
S3_USE_PATH_STYLE=true

# Secrets
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-long-random-jwt-secret-at-least-32-chars
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-very-strong-minio-password

# App settings
WORKER_COUNT=4
KIE_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback

# SSL / certbot
LETSENCRYPT_EMAIL=admin@yourdomain.com
